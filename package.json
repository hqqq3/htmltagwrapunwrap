{
  "name": "htmltagwrapunwrap",
  "displayName": "HTML Tag Wrap Unwrap",
  "description": "HTML标签包裹和删除工具",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "htmltagwrapunwrap.deleteTag",
        "title": "删除标签"
      },
      {
        "command": "htmltagwrapunwrap.wrapTag",
        "title": "包裹标签"
      }
    ],
    "keybindings": [
      {
        "command": "htmltagwrapunwrap.deleteTag",
        "key": "alt+d"
      },
      {
        "command": "htmltagwrapunwrap.wrapTag",
        "key": "alt+w"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^20.19.31",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0"
  }
}
